<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com" defer>
      <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'google-blue': '#1976d2',
                        'google-blue-light': '#e3f2fd',
                        'google-blue-hover': '#1565c0'
                    }
                }
            }
        }
    </script>
      
    </script>
    <link rel="stylesheet" href="/resources/css/index.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <title>
      {{ title  || "Google Contact" }}
    </title>

  </head>
  <body class="bg-page-full">
    <header class="flex padding-container justify-s-between sd-padding-container">
      <div class="flex justify-s-between items-center w-8">
        <div id="burger-menu" class="pointer icon transition">
          <span class="material-symbols-outlined">Menu</span>
        </div>
        <div class="w-4rem">
          <img src="../resources/assets/images/logo.png" alt="Google contact logo"/>
        </div>
        <h1 class="title title-level-1">
          Contacts
        </h1>
      </div>
      <div class="w-90 md-w-70 flex justify-start items-center md-justify-flex-end">
        <div class="flex input-field items-center">
          <div class="pointer icon justify-center items-center">
            <span class="material-symbols-outlined">search </span>
          </div>
          <input type="text" name="searchInput" id="searchInput" placeholder="Recherche" />
        </div>
      </div>
    </header>
    <main class="flex padding-container justify-s-between" id="main">
      <section id="side-bar" class="w-15 md-display-none">
        <div>
          <a href="/addContact"
            class="button flex items-center contain button-radius-07 button-hover-shadow"
            id="addcontact"
          >
            <span class="material-symbols-outlined margin-right-04rem">
              add
            </span>
            Créer un contact
          </a>
        </div>

        <div class="padding-top-bottom-1rem">
          <button
            type="button"
            class="button justify-s-between flex items-center button-hover-bg-color button-radius-10 w-100"
          >
            <p class="flex items-center justify-s-between">
              <span class="material-symbols-outlined margin-right-04rem">
                person
              </span>
              Contact
            </p>

            <span class="conteur">0 </span>
          </button>
          <button
            type="button"
            class="button flex items-center button-hover-bg-color button-radius-10 w-100 margin-top-bottom-1rem"
          >
            <span class="material-symbols-outlined margin-right-04rem">
              history </span>Fréquents
          </button>
        </div>
        <div>
          <div class="flex justify-s-between items-center">
            <h3 class="text title-level-3">
              Libellés
            </h3>
            <div class="pointer icon transition">
              <span class="material-symbols-outlined">add </span>
            </div>
          </div>
        </div>
      </section>
      <section id="main-section" class="w-90 main-section md-w-100 relative">
        {{{ await $slots.main() }}}
      </section>
    </main>
    <div class="position display-none md-display-block">
      <button type="button" class="button flex items-center contain button-radius-07 button-shadow">
        <span class="material-symbols-outlined">add </span>
      </button>
    </div>
  </body>

  <script>
    // Selects all elements
    const burgerMenu = document.querySelector("#burger-menu");
    
    const sideBarMenu = document.querySelector("#side-bar");
    
    const mainSection = document.querySelector("#main-section");
    // Callback functions
    
    const handleAddStyle = (element, style) => {
      element.classList.add(style);
    };
    
    const handleRemoveStyle = (element, style) => {
      element.classList.remove(style);
    };
    // Add events
    
    burgerMenu.addEventListener("click", event => {
      if (sideBarMenu.classList.contains("display-none")) {
        handleRemoveStyle(sideBarMenu, "display-none");
        handleRemoveStyle(mainSection, "w-100");
      } else {
        handleAddStyle(sideBarMenu, "display-none");
        handleAddStyle(mainSection, "w-100");
      }
    });














    // add contact
    let phoneCount = 1;
    let emailCount = 1;
    let addressCount = 1;

    function addPhoneField() {
        phoneCount++;
        const phoneSection = document.getElementById('phoneSection');
        const newField = document.createElement('div');
        newField.className = 'flex items-center mb-4 phone-field';
        newField.innerHTML = `
            <select class="text-gray-500 text-sm mr-4 min-w-20 border-none outline-none bg-transparent">
                <option value="mobile">Mobile</option>
                <option value="home">Domicile</option>
                <option value="work">Travail</option>
                <option value="fax">Fax</option>
                <option value="other">Autre</option>
            </select>
            <div class="border-b border-gray-200 flex-1 focus-within:border-b-2 focus-within:border-google-blue">
                <input type="tel" placeholder="Numéro de téléphone" class="w-full py-3 px-0 border-none outline-none text-base bg-transparent">
            </div>
            <button type="button" class="remove-btn ml-2 text-gray-500 text-lg w-6 h-6 flex items-center justify-center hover:bg-gray-100 rounded-full" onclick="removeField(this)">×</button>
        `;
        phoneSection.appendChild(newField);
        updateRemoveButtons('phone-field');
    }

    function addEmailField() {
        emailCount++;
        const emailSection = document.getElementById('emailSection');
        const newField = document.createElement('div');
        newField.className = 'flex items-center mb-4 email-field';
        newField.innerHTML = `
            <select class="text-gray-500 text-sm mr-4 min-w-20 border-none outline-none bg-transparent">
                <option value="home">Domicile</option>
                <option value="work">Travail</option>
                <option value="other">Autre</option>
            </select>
            <div class="border-b border-gray-200 flex-1 focus-within:border-b-2 focus-within:border-google-blue">
                <input type="email" placeholder="Adresse e-mail" class="w-full py-3 px-0 border-none outline-none text-base bg-transparent">
            </div>
            <button type="button" class="remove-btn ml-2 text-gray-500 text-lg w-6 h-6 flex items-center justify-center hover:bg-gray-100 rounded-full" onclick="removeField(this)">×</button>
        `;
        emailSection.appendChild(newField);
        updateRemoveButtons('email-field');
    }

    function addAddressField() {
        addressCount++;
        const addressSection = document.getElementById('addressSection');
        const newField = document.createElement('div');
        newField.className = 'address-field mb-4';
        newField.innerHTML = `
            <div class="flex items-center mb-2">
                <select class="text-gray-500 text-sm mr-4 min-w-20 border-none outline-none bg-transparent">
                    <option value="home">Domicile</option>
                    <option value="work">Travail</option>
                    <option value="other">Autre</option>
                </select>
                <button type="button" class="remove-btn ml-auto text-gray-500 text-lg w-6 h-6 flex items-center justify-center hover:bg-gray-100 rounded-full" onclick="removeField(this)">×</button>
            </div>
            <div class="border-b border-gray-200 mb-4 focus-within:border-b-2 focus-within:border-google-blue">
                <input type="text" placeholder="Rue" class="w-full py-3 px-0 border-none outline-none text-base bg-transparent">
            </div>
            <div class="border-b border-gray-200 mb-4 focus-within:border-b-2 focus-within:border-google-blue">
                <input type="text" placeholder="Ville" class="w-full py-3 px-0 border-none outline-none text-base bg-transparent">
            </div>
            <div class="border-b border-gray-200 mb-4 focus-within:border-b-2 focus-within:border-google-blue">
                <input type="text" placeholder="Code postal" class="w-full py-3 px-0 border-none outline-none text-base bg-transparent">
            </div>
            <div class="border-b border-gray-200 mb-4 focus-within:border-b-2 focus-within:border-google-blue">
                <input type="text" placeholder="Pays" class="w-full py-3 px-0 border-none outline-none text-base bg-transparent">
            </div>
        `;
        addressSection.appendChild(newField);
        updateRemoveButtons('address-field');
    }

    function removeField(button) {
        const field = button.closest('.phone-field, .email-field, .address-field');
        const fieldType = field.className.includes('phone') ? 'phone-field' : 
                        field.className.includes('email') ? 'email-field' : 'address-field';
        field.remove();
        updateRemoveButtons(fieldType);
    }

    function updateRemoveButtons(fieldType) {
        const fields = document.querySelectorAll(`.${fieldType}`);
        fields.forEach((field, index) => {
            const removeBtn = field.querySelector('.remove-btn');
            if (fields.length > 1) {
                removeBtn.classList.remove('hidden');
            } else {
                removeBtn.classList.add('hidden');
            }
        });
    }

    // Initialize remove buttons visibility
    updateRemoveButtons('phone-field');
    updateRemoveButtons('email-field');
    updateRemoveButtons('address-field');

    // Save button functionality
    document.getElementById('saveBtn').addEventListener('click', function() {
        alert('Contact sauvegardé ! (Fonctionnalité de démonstration)');
    });
  </script>
</html>
