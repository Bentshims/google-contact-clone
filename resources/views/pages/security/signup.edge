@layout.auth({title:"sign up"})

    @slot('main')
        <form action="" method="post">
            {{ csrfField() }}
            <div class="flex flex-col items-center justify-center h-screen">
                <h1 class="text-3xl font-bold mb-6">Sign Up</h1>
                <div class="mb-4">
                    <label for="fullname" class="block text-sm font-medium text-gray-700">fullname</label>
                    <input type="text" id="username" name="fullName" required
                    class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-google-blue focus:border-transparent">
                <div class="mb-4">
                    <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
                    <input type="email" id="email" name="email" required
                    class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-google-blue focus:border-transparent">
                </div>
                <div class="mb-4">
                    <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
                    <input type="password" id="password" name="password" required
                    class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-google-blue focus:border-transparent">
                </div>
            </div>    
            <div class="flex items-center justify-between">
                <button type="submit" class="w-full bg-google-blue text-white py-2 px-4 rounded-md hover:bg-google-blue-hover focus:outline-none focus:ring-2 focus:ring-google-blue focus:ring-opacity-50">
                    Sign Up
                </button>
            </div>
            <div class="mt-4 text-center">
                <p class="text-sm text-gray-600">
                    Already have an account? <a href="/login" class="text-google-blue hover:underline">Login</a>
                </p>
            </div>  
        </form>
    @endslot
@end