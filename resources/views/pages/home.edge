@layout.app({title: "Contacts"})
  @slot('main')

    <h3 class="title title-level-1">
      Contacts <span class="conteur">(0)</span>
    </h3>
    <table class="table-auto w-full">
      <thead class="pb-12">
        <tr class="text-left">
          <th class="w-1/3">
            Song
          </th>
          <th class="">
            Artist
          </th>
          <th class="">
            Year
          </th>
        </tr>
      </thead>
      <tbody class="border-t border-zinc-300 w-full ">
        <tr class="pt-6">
          <td>
            The Sliding Mr. Bones (Next Stop, Pottersville)
          </td>
          <td>
            Malcolm Lockyer
          </td>
          <td>
            1961
          </td>
        </tr>
        <tr class="pt-6">
          <td>
            Witchy Woman
          </td>
          <td>
            The Eagles
          </td>
          <td>
            1972
          </td>
        </tr>
        <tr class="pt-6">
          <td>
            Shining Star
          </td>
          <td>
            Earth, Wind, and Fire
          </td>
          <td>
            1975
          </td>
        </tr>
      </tbody>
    </table>
    <div class="contact-container flex justify-center items-center place" id="contactslist">
      <div id="nocontacts" class="nocontacts">
        <div class="illus-size-2rem">
          <img
            src="/resources/assets/images/emptycontacts_animation_cell4.png"
            alt="Empty contact illustration"
          />
        </div>
        <p class="text text-align-center">
          Aucun contact
        </p>
        <div class="flex justify-center items-center margin-top-bottom-1rem">
          <a
            href="/addContact"
            class="button button-radius-10 no-border flex items-center"
            type="button"
            id="addcontact"
          >
            <span class="material-symbols-outlined margin-right-04rem">
              person
            </span>
            Créer un contact
          </a>
        </div>
      </div>

    </div>

  @endslot
@end
